local function createButton(name, callback)
    local btn = Instance.new("TextButton")
    btn.Parent = MainFrame
    btn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    btn.Size = UDim2.new(1, -10, 0, 38)
    btn.Font = Enum.Font.SourceSansBold
    btn.Text = name .. ": [OFF]"
    btn.TextColor3 = Color3.fromRGB(255, 90, 90)
    btn.TextSize = 13
    
    local active = false
    btn.MouseButton1Click:Connect(function()
        active = not active
        if active then
            btn.Text = name .. ": [ON]"
            btn.TextColor3 = Color3.fromRGB(90, 255, 90)
            btn.BackgroundColor3 = Color3.fromRGB(30, 75, 30)
        else
            btn.Text = name .. ": [OFF]"
            btn.TextColor3 = Color3.fromRGB(255, 90, 90)
            btn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
        end
        callback(active)
    end)
end

createButton("Auto Pesas (Fuerza)", function(state) Config.AutoLift = state end)
createButton("Auto Golpes (Durabilidad)", function(state) Config.AutoPunch = state end)
createButton("Auto Velocidad", function(state) Config.AutoSpeed = state end)
createButton("Auto Rocas", function(state) Config.AutoRock = state end)
createButton("Auto Cristales", function(state) Config.AutoCrystals = state end)
createButton("Optimizar Lag (FPS Boost)", function(state) toggleFPSBoost(state) end)

