-- Walk on Water Parts setup
local parts = {}
local partSize = 2048
local totalDistance = 50000
local startPosition = Vector3.new(-2, -9.5, -2)

task.spawn(function()
    local numberOfParts = math.ceil(totalDistance / partSize)
    for x = 0, numberOfParts - 1 do
        for z = 0, numberOfParts - 1 do
            local part = Instance.new("Part", Workspace)
            part.Size = Vector3.new(partSize, 1, partSize)
            part.Position = startPosition + Vector3.new(x * partSize, 0, z * partSize)
            part.Anchored, part.Transparency, part.CanCollide = true, 1, true
            table.insert(parts, part)
        end
    end
end)

MainTab:AddSwitch("Walk on Water", function(bool)
    for _, part in ipairs(parts) do
        if part and part.Parent then part.CanCollide = bool end
    end
end)

