local function FormatNumber(value)
    local suffixes = {"", "K", "M", "B", "T", "Qa", "Qi"}
    local index = 1
    while value >= 1000 and index < #suffixes do
        value = value / 1000
        index = index + 1
    end
    return string.format("%.2f%s", value, suffixes[index])
end

local function FormatNumberWithCommas(value)
    local sign = value < 0 and "-" or ""
    local intPart, decPart = tostring(math.abs(value)):match("^(%d+)(%.?.*)$")
    intPart = intPart:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
    return sign .. intPart .. (decPart or "")
end

local function FormatDisplay(value)
    return "[ " .. FormatNumberWithCommas(value) .. " | " .. FormatNumber(value) .. " ]"
end

