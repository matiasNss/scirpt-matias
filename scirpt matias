local uptimeLabel = fastStrengthFolder:AddLabel("0d 0h 0m 0s")
local rebirthsInfoLabel = fastStrengthFolder:AddLabel("Renacimientos: 0 | Ganados: 0")
local requiredStrengthLabel = fastStrengthFolder:AddLabel("Fuerza Necesaria: 0")

local startTime = tick()
local initialRebirths = rebirthsStat.Value

local function getStrengthRequiredForRebirth()
    return math.floor(5000 + (2500 * rebirthsStat.Value))
end

task.spawn(function()
    while true do
        pcall(function()
            local currentRebirths = rebirthsStat.Value
            local totalGained = currentRebirths - initialRebirths
            local elapsed = tick() - startTime
            local d = math.floor(elapsed / 86400)
            local h = math.floor((elapsed % 86400) / 3600)
            local m = math.floor((elapsed % 3600) / 60)
            local s = math.floor(elapsed % 60)
            uptimeLabel.Text = string.format("%dd %dh %dm %ds", d, h, m, s)
            rebirthsInfoLabel.Text = "Renacimientos: " .. currentRebirths .. " | Ganados: " .. totalGained
            requiredStrengthLabel.Text = "Fuerza Necesaria: " .. FormatNumber(getStrengthRequiredForRebirth())
        end)
        task.wait(1)
    end
end)
