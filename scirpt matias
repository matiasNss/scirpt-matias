        return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    return ok and ping or 999
end

task.spawn(function()
    local farmingPaused = false
    while true do
        if getgenv()._AutoRepFarmEnabled then
            local ping = getPing()
            if ping > MAX_PING then farmingPaused = true end
            if ping <= MIN_PING then farmingPaused = false end
            if not farmingPaused then
                local ev = LocalPlayer:FindFirstChild("muscleEvent")
                if ev then
                    for _ = 1, REPS_PER_CYCLE do
                        pcall(function() ev:FireServer("rep") end)
                    end
                end
            end
        end
        task.wait()
    end
end)

