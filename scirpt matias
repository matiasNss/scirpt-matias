-- ==========================================
-- LIBRERÍA BÁSICA PARA MUSCLE LEGENDS (ROBLOX)
-- ==========================================

local MuscleLibrary = {}

-- Servicios de Roblox
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer

-- Estados de los loops (para poder encenderlos y apagarlos)
MuscleLibrary.Flags = {
    AutoLift = false,
    AutoPunch = false,
    AutoSpeed = false,
    AutoHandstands = false,
    AutoGems = false,
    AutoCrystals = false
}

-- Función auxiliar para obtener la herramienta activa o equipar un objeto específico
local function getTool(toolName)
    local character = LocalPlayer.Character
    if not character then return nil end
    
    -- Buscar en el personaje
    local tool = character:FindFirstChild(toolName)
    if tool then return tool end
    
    -- Buscar en la mochila
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if backpack then
        tool = backpack:FindFirstChild(toolName)
        if tool then
            tool.Parent = character
            return tool
        end
    end
    return nil
end

-- ==========================================
-- FUNCIONES PRINCIPALES
-- ==========================================

-- 1. Auto Entrenar Fuerza (Weights / Mancuernas)
function MuscleLibrary.ToggleAutoLift(state, weightName)
    MuscleLibrary.Flags.AutoLift = state
    weightName = weightName or "Weight" -- Nombre predeterminado del peso
    
    task.spawn(function()
        while MuscleLibrary.Flags.AutoLift do
            local tool = getTool(weightName)
            if tool then
                tool:Activate()
            end
            task.wait(0.1)
        end
    end)
end

-- 2. Auto Entrenar Durabilidad / Pelear (Punch / Golpear)
function MuscleLibrary.ToggleAutoPunch(state)
