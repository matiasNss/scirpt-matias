-- 5. Auto Recolectar Gemas del mapa
function MuscleLibrary.ToggleAutoGems(state)
    MuscleLibrary.Flags.AutoGems = state
    
    task.spawn(function()
        while MuscleLibrary.Flags.AutoGems do
            local character = LocalPlayer.Character
            local rootPart = character and character:FindFirstChild("HumanoidRootPart")
            
            if rootPart then
                -- Buscar carpetas comunes de gemas en Muscle Legends
                local gemsFolder = Workspace:FindFirstChild("Gems") or Workspace:FindFirstChild("Pickups")
                if gemsFolder then
                    for _, gem in ipairs(gemsFolder:GetChildren()) do
                        if gem:IsA("BasePart") or gem:IsA("Model") then
                            local part = gem:IsA("Model") and gem.PrimaryPart or gem
                            if part then
                                -- Teletransportarse brevemente a la gema para recogerla
                                rootPart.CFrame = part.CFrame
                                task.wait(0.05)
                            end
                        end
                    end
                end
            end
            task.wait(1)
        end
    end)
end

-- 6. Función de Utilidad: Teletransporte a zonas o áreas (ej. Gym principal, leyendas, etc.)
function MuscleLibrary.TeleportTo(position)
    local character = LocalPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if rootPart and typeof(position) == "CFrame" then
        rootPart.CFrame = position
    end
end

return MuscleLibrary
