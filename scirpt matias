-- HP BILLBOARD (BARRA DE VIDA EN CABEZAS)
-- ========================================================
task.spawn(function()
    task.wait(1)
    local suffixes = {{"Qi", 1e18}, {"Qa", 1e15}, {"T", 1e12}, {"B", 1e9}, {"M", 1e6}, {"K", 1e3}}

    local function formatNumber(n)
        for _, s in ipairs(suffixes) do
            if n >= s[2] then return string.format("%.2f%s", n / s[2], s[1]) end
        end
        return tostring(math.floor(n))
    end

    local function createBillboard(humanoid, character)
        if not character:FindFirstChild("Head") then return end
        if character:FindFirstChild("HP_BILLBOARD") then character.HP_BILLBOARD:Destroy() end

        local billboard = Instance.new("BillboardGui", character.Head)
        billboard.Name = "HP_BILLBOARD"
        billboard.Size = UDim2.new(6, 0, 1.2, 0)
        billboard.StudsOffset = Vector3.new(0, 3.5, 0)
        billboard.AlwaysOnTop = true
        billboard.MaxDistance = 200

        local frame = Instance.new("Frame", billboard)
        frame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
        frame.BackgroundTransparency = 0.3
        frame.Size = UDim2.new(1, 0, 1, 0)
        frame.BorderSizePixel = 0

        Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)

        local bar = Instance.new("Frame", frame)
        bar.BackgroundColor3 = Color3.fromRGB(255, 70, 70)
        bar.Size = UDim2.new(1, 0, 1, 0)
        bar.BorderSizePixel = 0

        local label = Instance.new("TextLabel", frame)
        label.BackgroundTransparency = 1
        label.Size = UDim2.new(1, 0, 1, 0)
        label.TextColor3 = Color3.new(1, 1, 1)
        label.Font = Enum.Font.GothamBold
        label.TextSize = 18
        label.TextStrokeTransparency = 0.5

        humanoid.HealthChanged:Connect(function()
            if humanoid and humanoid.Parent then
                bar.Size = UDim2.new(humanoid.Health / humanoid.MaxHealth, 0, 1, 0)
                label.Text = formatNumber(humanoid.Health) .. " / " .. formatNumber(humanoid.MaxHealth)
            end
        end)
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character then createBillboard(plr.Character:WaitForChild("Humanoid"), plr.Character) end
        plr.CharacterAdded:Connect(function(char) createBillboard(char:WaitForChild("Humanoid"), char) end)
    end
    Players.PlayerAdded:Connect(function(plr)
        plr.CharacterAdded:Connect(function(char) createBillboard(char:WaitForChild("Humanoid"), char) end)
    end)
end)

