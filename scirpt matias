-- SECCIÓN: RENACIMIENTO RÁPIDO
-- ========================================================
local fastStrengthFolder = AutoFarm:AddFolder("Funciones de Renacimiento Rápido")

local rebirthsStat = LocalPlayer:WaitForChild("leaderstats"):WaitForChild("Rebirths")

local uptimeLabel = fastStrengthFolder:AddLabel("Tiempo: 0d 0h 0m 0s")
local rebirthsInfoLabel = fastStrengthFolder:AddLabel("Renacimientos: 0 | Ganados: 0")
local requiredStrengthLabel = fastStrengthFolder:AddLabel("Fuerza Necesaria: 0")

local startTime = tick()
local initialRebirths = rebirthsStat.Value

local function getStrengthRequiredForRebirth()
    return math.floor(5000 + (2500 * rebirthsStat.Value))
end

task.spawn(function()
    while true do
        pcall(function()
            local currentRebirths = rebirthsStat.Value
            local totalRebirthsGained = currentRebirths - initialRebirths
            local elapsed = tick() - startTime

            local days = math.floor(elapsed / 86400)
            local hours = math.floor((elapsed % 86400) / 3600)
            local minutes = math.floor((elapsed % 3600) / 60)
            local seconds = math.floor(elapsed % 60)

            uptimeLabel.Text = string.format("Tiempo: %dd %dh %dm %ds", days, hours, minutes, seconds)
            rebirthsInfoLabel.Text = "Renacimientos: " .. currentRebirths .. " | Ganados: " .. totalRebirthsGained
            requiredStrengthLabel.Text = "Fuerza Necesaria: " .. FormatNumber(getStrengthRequiredForRebirth())
        end)
        task.wait(1)
    end
end)

