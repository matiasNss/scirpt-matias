-- Fast Rep Inteligente (Detecta herramientas en mochila y equipo activo sin congelarse)
task.spawn(function()
    while true do
        task.wait(0.12)
        if Config.FastRep and LocalPlayer.Character then
            local char = LocalPlayer.Character
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            
            if humanoid then
                local tool = char:FindFirstChild(Config.SelectedTool)
                if not tool then
                    local backpackTool = LocalPlayer.Backpack:FindFirstChild(Config.SelectedTool)
                    if backpackTool then
                        pcall(function()
                            humanoid:EquipTool(backpackTool)
                        end)
                    end
                else
                    pcall(function()
                        tool:Activate()
                    end)
                end
            end
        end
    end
end)

