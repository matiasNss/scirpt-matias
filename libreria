local Library = {}
Library.Unload = function() end

local CoreGui = game:GetService("CoreGui")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local LocalPlayer = Players.LocalPlayer

-- Eliminar UI previa si existe
if CoreGui:FindFirstChild("Mxtias777HubUI") then
    CoreGui:FindFirstChild("Mxtias777HubUI"):Destroy()
end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "Mxtias777HubUI"
ScreenGui.Parent = CoreGui
ScreenGui.ResetOnSpawn = false

function Library:AddWindow(title, options)
    options = options or {}
    local MainColor = options.main_color or Color3.fromRGB(0, 170, 255)
    local MinSize = options.min_size or Vector2.new(480, 420)

    local MainFrame = Instance.new("Frame")
    MainFrame.Name = "MainFrame"
    MainFrame.Size = UDim2.new(0, MinSize.X, 0, MinSize.Y)
    MainFrame.Position = UDim2.new(0.5, -MinSize.X/2, 0.5, -MinSize.Y/2)
    MainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
    MainFrame.BorderSizePixel = 0
    MainFrame.Active = true
    MainFrame.Draggable = true
    MainFrame.Parent = ScreenGui

    local UICorner = Instance.new("UICorner")
    UICorner.CornerRadius = UDim.new(0, 8)
    UICorner.Parent = MainFrame

    -- Título de la Ventana
    local TitleBar = Instance.new("Frame")
    TitleBar.Name = "TitleBar"
    TitleBar.Size = UDim2.new(1, 0, 0, 35)
    TitleBar.BackgroundColor3 = Color3.fromRGB(28, 28, 35)
    TitleBar.BorderSizePixel = 0
    TitleBar.Parent = MainFrame

    local TitleCorner = Instance.new("UICorner")
    TitleCorner.CornerRadius = UDim.new(0, 8)
    TitleCorner.Parent = TitleBar

    local TitleText = Instance.new("TextLabel")
    TitleText.Size = UDim2.new(1, -10, 1, 0)
    TitleText.Position = UDim2.new(0, 10, 0, 0)
    TitleText.Text = title
    TitleText.TextColor3 = Color3.fromRGB(255, 255, 255)
    TitleText.TextSize = 15
    TitleText.Font = Enum.Font.SourceSansBold
    TitleText.TextXAlignment = Enum.TextXAlignment.Left
    TitleText.BackgroundTransparency = 1
    TitleText.Parent = TitleBar

    -- Contenedor de Pestañas
    local TabBar = Instance.new("Frame")
    TabBar.Size = UDim2.new(0, 120, 1, -35)
    TabBar.Position = UDim2.new(0, 0, 0, 35)
    TabBar.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
    TabBar.BorderSizePixel = 0
    TabBar.Parent = MainFrame

    local TabContainer = Instance.new("Frame")
    TabContainer.Size = UDim2.new(1, -130, 1, -45)
    TabContainer.Position = UDim2.new(0, 125, 0, 40)
    TabContainer.BackgroundTransparency = 1
    TabContainer.Parent = MainFrame

    local UIListLayoutTabs = Instance.new("UIListLayout")
    UIListLayoutTabs.Parent = TabBar
    UIListLayoutTabs.SortOrder = Enum.SortOrder.LayoutOrder

    local WindowObj = {}
    local FirstTab = true

    function WindowObj:AddTab(tabName)
        local TabButton = Instance.new("TextButton")
        TabButton.Size = UDim2.new(1, 0, 0, 35)
        TabButton.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
        TabButton.Text = tabName
        TabButton.TextColor3 = Color3.fromRGB(150, 150, 150)
        TabButton.Font = Enum.Font.SourceSans
        TabButton.TextSize = 14
        TabButton.Parent = TabBar

        local TabPage = Instance.new("ScrollingFrame")
        TabPage.Size = UDim2.new(1, 0, 1, 0)
        TabPage.BackgroundTransparency = 1
        TabPage.ScrollBarThickness = 4
        TabPage.Visible = false
        TabPage.Parent = TabContainer

        local UIListLayoutPage = Instance.new("UIListLayout")
        UIListLayoutPage.Parent = TabPage
        UIListLayoutPage.SortOrder = Enum.SortOrder.LayoutOrder
        UIListLayoutPage.Padding = UDim.new(0, 6)

        if FirstTab then
            TabPage.Visible = true
            TabButton.TextColor3 = MainColor
            FirstTab = false
        end

        TabButton.MouseButton1Click:Connect(function()
            for _, child in pairs(TabContainer:GetChildren()) do
                if child:IsA("ScrollingFrame") then child.Visible = false end
            end
            for _, btn in pairs(TabBar:GetChildren()) do
                if btn:IsA("TextButton") then btn.TextColor3 = Color3.fromRGB(150, 150, 150) end
            end
            TabPage.Visible = true
            TabButton.TextColor3 = MainColor
        end)

        local TabObj = {}

        function TabObj:AddButton(btnText, callback)
            local Btn = Instance.new("TextButton")
            Btn.Size = UDim2.new(1, -10, 0, 30)
            Btn.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
            Btn.Text = btnText
            Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            Btn.Font = Enum.Font.SourceSans
            Btn.TextSize = 14
            Btn.Parent = TabPage

            local Corner = Instance.new("UICorner")
            Corner.CornerRadius = UDim.new(0, 4)
            Corner.Parent = Btn

            Btn.MouseButton1Click:Connect(function()
                if callback then callback() end
            end)
        end

        function TabObj:AddSwitch(switchText, callback)
            local Frame = Instance.new("Frame")
            Frame.Size = UDim2.new(1, -10, 0, 30)
            Frame.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
            Frame.Parent = TabPage

            local Corner = Instance.new("UICorner")
            Corner.CornerRadius = UDim.new(0, 4)
            Corner.Parent = Frame

            local Label = Instance.new("TextLabel")
            Label.Size = UDim2.new(0.7, 0, 1, 0)
            Label.Position = UDim2.new(0, 10, 0, 0)
            Label.Text = switchText
            Label.TextColor3 = Color3.fromRGB(255, 255, 255)
            Label.Font = Enum.Font.SourceSans
            Label.TextSize = 14
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.BackgroundTransparency = 1
            Label.Parent = Frame

            local ToggleBtn = Instance.new("TextButton")
            ToggleBtn.Size = UDim2.new(0, 40, 0, 20)
            ToggleBtn.Position = UDim2.new(1, -45, 0.5, -10)
            ToggleBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
            ToggleBtn.Text = "OFF"
            ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            ToggleBtn.Font = Enum.Font.SourceSansBold
            ToggleBtn.TextSize = 11
            ToggleBtn.Parent = Frame

            local ToggleCorner = Instance.new("UICorner")
            ToggleCorner.CornerRadius = UDim.new(0, 4)
            ToggleCorner.Parent = ToggleBtn

            local toggled = false
            ToggleBtn.MouseButton1Click:Connect(function()
                toggled = not toggled
                if toggled then
                    ToggleBtn.BackgroundColor3 = MainColor
                    ToggleBtn.Text = "ON"
                else
                    ToggleBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
                    ToggleBtn.Text = "OFF"
                end
                if callback then callback(toggled) end
            end)
        end

        return TabObj
    end

    return WindowObj
end

-- ==========================================
-- INICIALIZACIÓN DE MXTIAS777 HUB
-- ==========================================

local Window = Library:AddWindow("Mxtias777 Hub", {
    main_color = Color3.fromRGB(0, 170, 255),
    min_size = Vector2.new(480, 420)
})

local FarmTab = Window:AddTab("Farm Rep")
local FarmOpTab = Window:AddTab("Farm Op")
local GymTab = Window:AddTab("Gym Industrial")

-- Variables de Estado
getgenv()._FastRep = false
getgenv()._StrengthOp = false
getgenv()._AutoSmartRebirth = false

local rEvents = ReplicatedStorage:WaitForChild("rEvents")
local muscleEvent = rEvents:WaitForChild("muscleEvent")
local rebirthRemote = rEvents:WaitForChild("rebirthRemote")
local petRemote = rEvents:FindFirstChild("petRemote")

-- Configuración de Nombres de Pets para Swapping
local PET_FORZA = "PetFuerza"      -- Cambia aquí el nombre exacto de tu pet de Fuerza
local PET_REBIRTH = "PetRebirth"    -- Cambia aquí el nombre exacto de tu pet de Rebirth

-- 1. Fast Rep
FarmTab:AddSwitch("Fast Rep (Batched)", function(state)
    getgenv()._FastRep = state
end)

task.spawn(function()
    while true do
        task.wait(0.01)
        if getgenv()._FastRep then
            pcall(function()
                for i = 1, 15 do
                    muscleEvent:FireServer("punch", "leftHand")
                    muscleEvent:FireServer("punch", "rightHand")
                end
            end)
        end
    end
end)

-- 2. Auto Rebirth Mixto (Con Swapping de Pets)
FarmTab:AddSwitch("Auto Rebirth Mixto", function(state)
    getgenv()._AutoSmartRebirth = state
end)

task.spawn(function()
    while true do
        task.wait(0.2)
        if getgenv()._AutoSmartRebirth then
            pcall(function()
                -- 1. Desequipar pets de velocidad/fuerza
                if petRemote then
                    petRemote:InvokeServer("unequipAllPets")
                    task.wait(0.1)
                    
                    -- 2. Equipar Pet de Rebirth (para aprovechar el multiplicador)
                    petRemote:InvokeServer("equipPet", PET_REBIRTH)
                    task.wait(0.15)
                end
                
                -- 3. Renacer
                if rebirthRemote then
                    rebirthRemote:InvokeServer("rebirthRequest")
                    task.wait(0.2)
                end
                
                -- 4. Volver a equipar Pets de Fuerza para farmeo rápido
                if petRemote then
                    petRemote:InvokeServer("unequipAllPets")
                    task.wait(0.1)
                    petRemote:InvokeServer("equipPet", PET_FORZA)
                end
            end)
        end
    end
end)

-- 3. Strength Op (55 Reps/Ciclo)
FarmOpTab:AddSwitch("Strength Op (Ultra)", function(state)
    getgenv()._StrengthOp = state
end)

task.spawn(function()
    while true do
        task.wait(0.005)
        if getgenv()._StrengthOp then
            pcall(function()
                for i = 1, 55 do
                    muscleEvent:FireServer("punch", "rightHand")
                end
            end)
        end
    end
end)

-- Teleports Industriales
GymTab:AddButton("TP: Industrial Lift", function()
