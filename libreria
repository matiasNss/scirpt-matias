-- LÓGICA ESPECÍFICA DE MUSCLE LEGENDS
--------------------------------------------------------------------------------

local Window = MuscleLib:CreateWindow("Muscle Legends | Custom Lib")

-- Pestaña 1: Auto Farm
local FarmTab = Window:CreateTab("Auto Farm")

FarmTab:CreateToggle("Auto Fuerza (Equipar Pesa)", false, function(val)
    Flags.AutoStrength = val
    task.spawn(function()
        while Flags.AutoStrength do
            -- Equipa la herramienta de pesa en el inventario y activa el evento
            for _, tool in pairs(LocalPlayer.Backpack:GetChildren()) do
                if tool:IsA("Tool") and (tool.Name:find("Weight") or tool.Name:find("Pushups") or tool.Name:find("Situps")) then
                    tool.Parent = LocalPlayer.Character
                end
            end
            LocalPlayer.muscleEvent:FireServer("rep")
            task.wait(0.1)
        end
    end)
end)

FarmTab:CreateToggle("Auto Rebirth", false, function(val)
    Flags.AutoRebirth = val
    task.spawn(function()
        while Flags.AutoRebirth do
            ReplicatedStorage.rEvents.rebirthRemote:InvokeServer("rebirthRequest")
            task.wait(1)
        end
    end)
end)

FarmTab:CreateToggle("Anti-AFK", true, function(val)
    Flags.AntiAFK = val
end)

-- Pestaña 2: Teleports (Gimnasios)
local TeleportTab = Window:CreateTab("Gimnasios")

local Gyms = {
    ["Spawn / Playa"] = CFrame.new(-38, 7, 211),
    ["Frost Gym (1 Rebirth)"] = CFrame.new(-2623, 7, -409),
    ["Mythical Gym (5 Rebirths)"] = CFrame.new(2250, 7, 1073),
    ["Eternal Gym (15 Rebirths)"] = CFrame.new(-6758, 7, -1284),
    ["Legends Gym (30 Rebirths)"] = CFrame.new(4603, 987, -3897),
    ["Muscle King Gym"] = CFrame.new(-8625, 17, -5730)
}

for gymName, cframePos in pairs(Gyms) do
    TeleportTab:CreateButton("TP: " .. gymName, function()
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            LocalPlayer.Character.HumanoidRootPart.CFrame = cframePos
        end
    end)
end

-- Pestaña 3: Jugador
local PlayerTab = Window:CreateTab("Jugador")

PlayerTab:CreateButton("Velocidad Rápida (100)", function()
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid.WalkSpeed = 100
    end
end)

PlayerTab:CreateButton("Velocidad Normal (16)", function()
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid.WalkSpeed = 16
    end
end)

PlayerTab:CreateButton("Reclamar Todos los Cofres", function()
    local chests = {"Magma Chest", "Mythical Chest", "Golden Chest", "Enchanted Chest", "Legends Chest"}
    for _, chestName in pairs(chests) do
        ReplicatedStorage.rEvents.checkChestRemote:InvokeServer(chestName)
        task.wait(0.2)
    end
end)

return MuscleLib
