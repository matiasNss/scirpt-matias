local function new(class, props, children)
    local inst = Instance.new(class)
    for k, v in pairs(props or {}) do inst[k] = v end
    for _, c in ipairs(children or {}) do c.Parent = inst end
    return inst
end

local function drag(frame, handle)
    handle = handle or frame
    local dragging, dragStart, startPos
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos  = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

function Nova:Notify(settings)
    settings = settings or {}
    local title = settings.Title or "Nova"
    local text  = settings.Text  or ""
    local dur   = settings.Duration or 4

    local gui = new("ScreenGui", { Name = "NovaNotify", Parent = parentGui, ResetOnSpawn = false })
    local frame = new("Frame", {
        Parent = gui, Size = UDim2.new(0, 260, 0, 70),
        Position = UDim2.new(1, -280, 1, -90),
        BackgroundColor3 = Color3.fromRGB(28, 28, 32),
        BorderSizePixel = 0, BackgroundTransparency = 1,
    }, {
        new("UICorner", { CornerRadius = UDim.new(0, 8) }),
        new("UIStroke", { Color = Color3.fromRGB(80, 80, 90), Thickness = 1 }),
    })
    new("TextLabel", {
        Parent = frame, BackgroundTransparency = 1,
        Position = UDim2.new(0, 12, 0, 6), Size = UDim2.new(1, -24, 0, 22),
        Font = Enum.Font.GothamBold, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left,
        TextColor3 = Color3.fromRGB(255, 255, 255), Text = title,
    })
    new("TextLabel", {
        Parent = frame, BackgroundTransparency = 1,
        Position = UDim2.new(0, 12, 0, 28), Size = UDim2.new(1, -24, 0, 36),
        Font = Enum.Font.Gotham, TextSize = 12, TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
        TextColor3 = Color3.fromRGB(200, 200, 210), Text = text,
    })
    TweenService:Create(frame, TweenInfo.new(0.3), { BackgroundTransparency = 0 }):Play()
    task.delay(dur, function()
        local t = TweenService:Create(frame, TweenInfo.new(0.3), { BackgroundTransparency = 1 })
        t:Play(); t.Completed:Wait(); gui:Destroy()
    end)
end

function Nova:MakeWindow(settings)
    settings = settings or {}
    local name = settings.Name or "Nova"

    local gui = new("ScreenGui", {
        Name = "NovaGui", Parent = parentGui,
        ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    })
    local main = new("Frame", {
        Parent = gui, Size = UDim2.new(0, 520, 0, 360),
        Position = UDim2.new(0.5, -260, 0.5, -180),
        BackgroundColor3 = Color3.fromRGB(20, 20, 24), BorderSizePixel = 0,
    }, {
        new("UICorner", { CornerRadius = UDim.new(0, 8) }),
        new("UIStroke", { Color = Color3.fromRGB(60, 60, 70), Thickness = 1 }),
    })
    local topbar = new("Frame", {
        Parent = main, Size = UDim2.new(1, 0, 0, 34),
        BackgroundColor3 = Color3.fromRGB(30, 30, 36), BorderSizePixel = 0,
    }, { new("UICorner", { CornerRadius = UDim.new(0, 8) }) })
    new("Frame", {
        Parent = topbar, Size = UDim2.new(1, 0, 0, 12),
        Position = UDim2.new(0, 0, 1, -12),
        BackgroundColor3 = Color3.fromRGB(30, 30, 36), BorderSizePixel = 0,
    })
    new("TextLabel", {
        Parent = topbar, BackgroundTransparency = 1,
        Position = UDim2.new(0, 14, 0, 0), Size = UDim2.new(1, -60, 1, 0),
        Font = Enum.Font.GothamBold, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left,
        TextColor3 = Color3.fromRGB(240, 240, 245), Text = name,
    })
    local closeBtn = new("TextButton", {
        Parent = topbar, Size = UDim2.new(0, 34, 1, 0),
        Position = UDim2.new(1, -34, 0, 0), BackgroundTransparency = 1,
        Text = "×", Font = Enum.Font.GothamBold, TextSize = 20,
        TextColor3 = Color3.fromRGB(255, 120, 120),
    })
    closeBtn.MouseButton1Click:Connect(function() gui:Destroy() end)
    drag(main, topbar)

    local tabBar = new("Frame", {
        Parent = main, Size = UDim2.new(0, 130, 1, -44),
        Position = UDim2.new(0, 10, 0, 44), BackgroundTransparency = 1,
    })
    new("UIListLayout", { Parent = tabBar, Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder })

    local content = new("ScrollingFrame", {
        Parent = main, Size = UDim2.new(1, -160, 1, -54),
        Position = UDim2.new(0, 150, 0, 44), BackgroundTransparency = 1,
        BorderSizePixel = 0, ScrollBarThickness = 3,
        ScrollBarImageColor3 = Color3.fromRGB(80, 80, 90),
        CanvasSize = UDim2.new(0, 0, 0, 0),
    })
    new("UIListLayout", { Parent = content, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder })
    new("UIPadding", { Parent = content, PaddingRight = UDim.new(0, 6) })

    local tabs, activeTab, activeBtn = {}, nil, nil

    local function selectTab(tab)
        activeTab = tab
        for _, c in ipairs(content:GetChildren()) do
            if c:IsA("ScrollingFrame") then c.Visible = (c == tab.Container) end
        end
        if activeBtn then activeBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 36) end
        activeBtn = tab.Button
        activeBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
    end

    local Window = { Gui = gui, Main = main, Tabs = tabs }

    function Window:MakeTab(tabSettings)
        tabSettings = tabSettings or {}
        local tabName = tabSettings.Name or "Tab"

        local btn = new("TextButton", {
            Parent = tabBar, Size = UDim2.new(1, 0, 0, 30),
            BackgroundColor3 = Color3.fromRGB(30, 30, 36), BorderSizePixel = 0,
            Text = "  " .. tabName, Font = Enum.Font.Gotham, TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Color3.fromRGB(220, 220, 230),
            AutoButtonColor = false,
        }, { new("UICorner", { CornerRadius = UDim.new(0, 6) }) })

        local container = new("ScrollingFrame", {
            Parent = content, Size = UDim2.new(1, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            CanvasSize = UDim2.new(0, 0, 0, 0),
            BackgroundTransparency = 1, BorderSizePixel = 0,
            ScrollBarThickness = 3, Visible = false,
        })
        new("UIListLayout", { Parent = container, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder })

        local tab = { Name = tabName, Button = btn, Container = container }
        tabs[tabName] = tab
        btn.MouseButton1Click:Connect(function() selectTab(tab) end)
        if not activeTab then selectTab(tab) end

        function tab:AddSection(s)
            s = s or {}
            local f = new("Frame", { Parent = container, Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = 1 })
            new("TextLabel", {
                Parent = f, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0),
                Font = Enum.Font.GothamBold, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left,
                TextColor3 = Color3.fromRGB(150, 150, 165), Text = (s.Name or "Section"):upper(),
            })
            return f
        end

        function tab:AddButton(s)
            s = s or {}
            local b = new("TextButton", {
                Parent = container, Size = UDim2.new(1, 0, 0, 32),
                BackgroundColor3 = Color3.fromRGB(35, 35, 42), BorderSizePixel = 0,
                Font = Enum.Font.Gotham, TextSize = 13,
                TextColor3 = Color3.fromRGB(230, 230, 235),
                Text = s.Name or "Button", AutoButtonColor = false,
            }, { new("UICorner", { CornerRadius = UDim.new(0, 6) }) })
            b.MouseButton1Click:Connect(function() if s.Callback then pcall(s.Callback) end end)
            return b
        end

        function tab:AddToggle(s)
            s = s or {}
            local state = s.Default and true or false
            local frame = new("Frame", {
                Parent = container, Size = UDim2.new(1, 0, 0, 34),
                BackgroundColor3 = Color3.fromRGB(35, 35, 42), BorderSizePixel = 0,
            }, { new("UICorner", { CornerRadius = UDim.new(0, 6) }) })
            new("TextLabel", {
                Parent = frame, BackgroundTransparency = 1,
                Position = UDim2.new(0, 10, 0, 0), Size = UDim2.new(1, -60, 1, 0),
                Font = Enum.Font.Gotham, TextSize = 13,
                TextColor3 = Color3.fromRGB(230, 230, 235),
                TextXAlignment = Enum.TextXAlignment.Left, Text = s.Name or "Toggle",
            })
            local knobBg = new("Frame", {
                Parent = frame, Size = UDim2.new(0, 36, 0, 18),
                Position = UDim2.new(1, -46, 0.5, -9),
                BackgroundColor3 = Color3.fromRGB(60, 60, 70), BorderSizePixel = 0,
            }, { new("UICorner", { CornerRadius = UDim.new(1, 0) }) })
            local knob = new("Frame", {
                Parent = knobBg, Size = UDim2.new(0, 14, 0, 14),
                Position = UDim2.new(0, 2, 0.5, -7),
                BackgroundColor3 = Color3.fromRGB(240, 240, 245), BorderSizePixel = 0,
            }, { new("UICorner", { CornerRadius = UDim.new(1, 0) }) })
            local function apply(v, fire)
                state = v
                TweenService:Create(knobBg, TweenInfo.new(0.15), {
                    BackgroundColor3 = v and Color3.fromRGB(80, 140, 255) or Color3.fromRGB(60, 60, 70)
                }):Play()
                TweenService:Create(knob, TweenInfo.new(0.15), {
                    Position = v and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
                }):Play()
                if fire and s.Callback then pcall(s.Callback, v) end
            end
            if state then apply(true, false) end
            local click = new("TextButton", {
                Parent = frame, Size = UDim2.new(1, 0, 1, 0),
                BackgroundTransparency = 1, Text = "",
            })
            click.MouseButton1Click:Connect(function() apply(not state, true) end)
            return { Set = function(v) apply(v, true) end, Get = function() return state end }
        end

        function tab:AddSlider(s)
            s = s or {}
            local min, max = s.Min or 0, s.Max or 100
            local val = math.clamp(s.Default or min, min, max)
            local step = s.Step or 1
            local frame = new("Frame", {
                Parent = container, Size = UDim2.new(1, 0, 0, 50),
                BackgroundColor3 = Color3.fromRGB(35, 35, 42), BorderSizePixel = 0,
            }, { new("UICorner", { CornerRadius = UDim.new(0, 6) }) })
            new("TextLabel", {
                Parent = frame, BackgroundTransparency = 1,
                Position = UDim2.new(0, 10, 0, 4), Size = UDim2.new(1, -20, 0, 18),
                Font = Enum.Font.Gotham, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left,
                TextColor3 = Color3.fromRGB(230, 230, 235), Text = s.Name or "Slider",
            })
            local valLbl = new("TextLabel", {
                Parent = frame, BackgroundTransparency = 1,
                Position = UDim2.new(0, 10, 0, 4), Size = UDim2.new(1, -20, 0, 18),
                Font = Enum.Font.Gotham, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Right,
                TextColor3 = Color3.fromRGB(150, 200, 255), Text = tostring(val),
            })
            local bar = new("Frame", {
                Parent = frame, Size = UDim2.new(1, -20, 0, 6),
                Position = UDim2.new(0, 10, 0, 32),
                BackgroundColor3 = Color3.fromRGB(60, 60, 70), BorderSizePixel = 0,
            }, { new("UICorner", { CornerRadius = UDim.new(1, 0) }) })
            local fill = new("Frame", {
                Parent = bar, Size = UDim2.new((val - min) / (max - min), 0, 1, 0),
                BackgroundColor3 = Color3.fromRGB(80, 140, 255), BorderSizePixel = 0,
            }, { new("UICorner", { CornerRadius = UDim.new(1, 0) }) })
            local hit = new("TextButton", {
                Parent = bar, Size = UDim2.new(1, 0, 2, 0), Position = UDim2.new(0, 0, -0.5, 0),
                BackgroundTransparency = 1, Text = "",
            })
            local function setValue(v, fire)
                v = math.clamp(v, min, max)
                if step > 0 then v = math.floor(v / step + 0.5) * step end
                val = v
                fill.Size = UDim2.new((val - min) / (max - min), 0, 1, 0)
                valLbl.Text = tostring(val)
                if fire and s.Callback then pcall(s.Callback, val) end
            end
            local dragging = false
            local function onInput(input)
                local rel = (input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X
                setValue(min + (max - min) * rel, true)
            end
            hit.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true; onInput(input)
                end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch) then onInput(input) end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
            end)
            return { Set = function(v) setValue(v, true) end, Get = function() return val end }
        end

        function tab:AddTextbox(s)
            s = s or {}
            local frame = new("Frame", {
                Parent = container, Size = UDim2.new(1, 0, 0, 34),
                BackgroundColor3 = Color3.fromRGB(35, 35, 42), BorderSizePixel = 0,
            }, { new("UICorner", { CornerRadius = UDim.new(0, 6) }) })
            new("TextLabel", {
                Parent = frame, BackgroundTransparency = 1,
                Position = UDim2.new(0, 10, 0, 0), Size = UDim2.new(0, 100, 1, 0),
                Font = Enum.Font.Gotham, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left,
                TextColor3 = Color3.fromRGB(230, 230, 235), Text = s.Name or "Input",
            })
            local box = new("TextBox", {
                Parent = frame, BackgroundColor3 = Color3.fromRGB(25, 25, 30),
                BorderSizePixel = 0, ClearTextOnFocus = false,
                Position = UDim2.new(1, -180, 0.5, -12), Size = UDim2.new(0, 170, 0, 24),
                Font = Enum.Font.Gotham, TextSize = 13, TextColor3 = Color3.fromRGB(230, 230, 235),
                PlaceholderText = s.Placeholder or "", PlaceholderColor3 = Color3.fromRGB(120, 120, 130),
                Text = s.Default or "",
            }, { new("UICorner", { CornerRadius = UDim.new(0, 4) }) })
            box.FocusLost:Connect(function(enter)
                if enter and s.Callback then pcall(s.Callback, box.Text) end
            end)
            return { Set = function(v) box.Text = v end, Get = function() return box.Text end }
        end

        return tab
    end

    function Window:SelectTab(n) if tabs[n] then selectTab(tabs[n]) end end
    function Window:Destroy() gui:Destroy() end
    return Window
end

