    FastRep = false,
    AutoRebirth = false,
    AntiAFK = false,
    SelectedTool = "Punch"
}

-- Variables para el cálculo de tasas automáticas (inspirado en el video)
local sessionStartTime = tick()
local initialStrength = 0
local initialDurability = 0
local lastStrength = 0
local lastDurability = 0

-- Intentar obtener valores iniciales seguros
task.spawn(function()
    task.wait(1)
    if LocalPlayer:FindFirstChild("leaderstats") and LocalPlayer.leaderstats:FindFirstChild("Strength") then
        initialStrength = LocalPlayer.leaderstats.Strength.Value
        lastStrength = initialStrength
    end
    if LocalPlayer:FindFirstChild("Durability") then
        initialDurability = LocalPlayer.Durability.Value
        lastDurability = initialDurability
    end
end)

-- Función auxiliar para formatear números grandes estilo Muscle Legends (K, M, B, T, Qa, etc.)
local function formatValue(val)
    if not val then return "0" end
    if val >= 1e15 then
        return string.format("%.2fQa", val / 1e15)
    elseif val >= 1e12 then
        return string.format("%.2fT", val / 1e12)
    elseif val >= 1e9 then
        return string.format("%.2fB", val / 1e9)
    elseif val >= 1e6 then
        return string.format("%.2fM", val / 1e6)
    elseif val >= 1e3 then
        return string.format("%.2fK", val / 1e3)
    else
        return tostring(math.floor(val))
    end
end

-- Función para formatear el tiempo transcurrido (d h m s)
local function formatTime(seconds)
    local d = math.floor(seconds / 86400)
    local h = math.floor((seconds % 86400) / 3600)
    local m = math.floor((seconds % 3600) / 60)
    local s = math.floor(seconds % 60)
    return string.format("%dd %dh %dm %ds", d, h, m, s)
end


