local OrionLib = loadstring(game:HttpGet(('https://raw.githubusercontent.com/shlexware/Orion/main/source')))()
local Window = OrionLib:MakeWindow({
    Name = "mxtias hub 777 | Muscle Legends",
    HidePremium = false,
    SaveConfig = true,
    ConfigFolder = "mxtias_hub_777"
})

-- Variables de Estado
local AutoFarm = false
local AutoRebirth = false
local AutoPunch = false

-- Pestaña Principal (Farm)
local MainTab = Window:MakeTab({
    Name = "Farm Automático",
    Icon = "rbxassetid://4483345998",
    PremiumOnly = false
})

MainTab:AddSection({
    Name = "Acciones de Entrenamiento"
})

MainTab:AddToggle({
    Name = "Auto Lift (Fuerza)",
    Default = false,
    Callback = function(Value)
        AutoFarm = Value
        task.spawn(function()
            while AutoFarm do
                task.wait(0.1)
                pcall(function()
                    game:GetService("Players").LocalPlayer.muscleEvent:FireServer("rep")
                end)
            end
        end)
    end    
})

MainTab:AddToggle({
    Name = "Auto Puñetazo",
    Default = false,
    Callback = function(Value)
        AutoPunch = Value
        task.spawn(function()
            while AutoPunch do
                task.wait(0.1)
                pcall(function()
                    local player = game:GetService("Players").LocalPlayer
                    local punch = player.Backpack:FindFirstChild("Punch") or player.Character:FindFirstChild("Punch")
                    if punch then
                        punch.Parent = player.Character
                        punch:Activate()
                    end
                end)
            end
        end)
    end    
})

MainTab:AddToggle({
    Name = "Auto Rebirth",
    Default = false,
    Callback = function(Value)
        AutoRebirth = Value
        task.spawn(function()
            while AutoRebirth do
                task.wait(1)
                pcall(function()
                    game:GetService("ReplicatedStorage").rEvents.rebirthRemote:InvokeServer("rebirthRequest")
                end)
            end
        end)
    end    
})

-- Pestaña Calculadora de Estadísticas
local StatsTab = Window:MakeTab({
    Name = "Calculadora Stats",
    Icon = "rbxassetid://4483345998",
    PremiumOnly = false
})

StatsTab:AddSection({
    Name = "Proyección de Fuerza y Durabilidad"
})

-- Etiquetas de la Calculadora
local ForcePerHourLabel = StatsTab:AddLabel("Fuerza por Hora: Calculando...")
local ForcePerDayLabel = StatsTab:AddLabel("Fuerza por Día: Calculando...")
local ForcePerWeekLabel = StatsTab:AddLabel("Fuerza por Semana: Calculando...")

StatsTab:AddSection({
    Name = "Proyección de Durabilidad"
})

local DurabilityPerHourLabel = StatsTab:AddLabel("Durabilidad por Hora: Calculando...")
local DurabilityPerDayLabel = StatsTab:AddLabel("Durabilidad por Día: Calculando...")
local DurabilityPerWeekLabel = StatsTab:AddLabel("Durabilidad por Semana: Calculando...")

-- Lógica de la Calculadora en tiempo real
task.spawn(function()
    local player = game:GetService("Players").LocalPlayer
    local leaderstats = player:WaitForChild("leaderstats")
    
    local initialStrength = leaderstats:WaitForChild("Strength").Value
    local initialDurability = leaderstats:WaitForChild("Durability").Value
    local startTime = tick()

    while task.wait(3) do
        pcall(function()
            local currentTime = tick()
            local timeElapsed = currentTime - startTime
            
            if timeElapsed > 0 then
                local currentStrength = leaderstats.Strength.Value
                local currentDurability = leaderstats.Durability.Value
                
                local strengthGained = currentStrength - initialStrength
                local durabilityGained = currentDurability - initialDurability
                
                -- Fuerza por segundo/hora/día/semana
                local strengthPerSec = strengthGained / timeElapsed
                local strHour = math.floor(strengthPerSec * 3600)
                local strDay = math.floor(strengthPerSec * 86400)
                local strWeek = math.floor(strengthPerSec * 604800)
                
                -- Durabilidad por segundo/hora/día/semana
                local durabilityPerSec = durabilityGained / timeElapsed
                local durHour = math.floor(durabilityPerSec * 3600)
                local durDay = math.floor(durabilityPerSec * 86400)
                local durWeek = math.floor(durabilityPerSec * 604800)
                
                -- Actualizar Interfaz
                ForcePerHourLabel:Set("Fuerza por Hora: " .. tostring(strHour))
                ForcePerDayLabel:Set("Fuerza por Día: " .. tostring(strDay))
                ForcePerWeekLabel:Set("Fuerza por Semana: " .. tostring(strWeek))
                
                DurabilityPerHourLabel:Set("Durabilidad por Hora: " .. tostring(durHour))
                DurabilityPerDayLabel:Set("Durabilidad por Día: " .. tostring(durDay))
                DurabilityPerWeekLabel:Set("Durabilidad por Semana: " .. tostring(durWeek))
            end
        end)
    end
end)

-- Pestaña Ajustes
local MiscTab = Window:MakeTab({
    Name = "Ajustes",
    Icon = "rbxassetid://4483345998",
    PremiumOnly = false
})

MiscTab:AddSlider({
    Name = "Velocidad de Movimiento",
    Min = 16,
    Max = 500,
    Default = 16,
    Color = Color3.fromRGB(255, 0, 0),
    Increment = 1,
    ValueName = "Speed",
    Callback = function(Value)
        game:GetService("Players").LocalPlayer.Character.Humanoid.WalkSpeed = Value
    end    
})

OrionLib:Init()
