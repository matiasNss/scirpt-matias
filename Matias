-- ==========================================
-- LÓGICA / LOOPS DEL SCRIPT (Optimizado)
-- ==========================================

-- Loop Fast Rep Ultrarrápido (Equipa y actica directo por RunService para máxima velocidad)
RunService.Heartbeat:Connect(function()
    if Config.FastRep and LocalPlayer.Character then
        local char = LocalPlayer.Character
        local backpack = LocalPlayer.Backpack
        local tool = backpack:FindFirstChild(Config.SelectedTool) or char:FindFirstChild(Config.SelectedTool)
        
        if tool then
            if tool.Parent == backpack then
                local humanoid = char:FindFirstChildOfClass("Humanoid")
                if humanoid then
                    humanoid:EquipTool(tool)
                end
            else
                tool:Activate()
            end
        end
    end
end)

-- Loop Auto Rebirth
task.spawn(function()
    while task.wait(0.4) do
        if Config.AutoRebirth then
            local rebirthEvent = game:GetService("ReplicatedStorage"):FindFirstChild("rEvents") 
                and game:GetService("ReplicatedStorage").rEvents:FindFirstChild("rebirthRemote")
            
            if rebirthEvent then
                rebirthEvent:InvokeServer("rebirthRequest")
            end
        end
    end
end)

-- Anti AFK
LocalPlayer.Idled:Connect(function()
    if Config.AntiAFK then
        VirtualUser:CaptureController()
        VirtualUser:ClickButton2(Vector2.new(0, 0))
    end
end)

-- Loop de Actualización de Estadísticas y Tasas Automáticas (Estilo Video)
task.spawn(function()
    while task.wait(1) do
        local currentTime = tick()
        local elapsedSeconds = currentTime - sessionStartTime
        TimeElapsedLabel.Text = "Fast Rep Time: " .. formatTime(elapsedSeconds)
        
        -- Obtener valores actuales de los leaderstats y atributos del jugador
        local currentStrength = 0
        local currentDurability = 0
        
        if LocalPlayer:FindFirstChild("leaderstats") and LocalPlayer.leaderstats:FindFirstChild("Strength") then
            currentStrength = LocalPlayer.leaderstats.Strength.Value
        end
        if LocalPlayer:FindFirstChild("Durability") then
            currentDurability = LocalPlayer.Durability.Value
        end
        
        -- Calcular ganancias acumuladas desde el inicio
        local gainedStrength = math.max(0, currentStrength - initialStrength)
        local gainedDurability = math.max(0, currentDurability - initialDurability)
        
        if elapsedSeconds > 2 then
            -- Calcular por hora, día y semana basados en el ritmo real de ganancia
            local strPerSec = gainedStrength / elapsedSeconds
            local durPerSec = gainedDurability / elapsedSeconds
            
            local strHour = strPerSec * 3600
            local strDay = strHour * 24
            local strWeek = strDay * 7
            
            local durHour = durPerSec * 3600
            local durDay = durHour * 24
            local durWeek = durDay * 7
            
            StrengthRateLabel.Text = string.format("Strength Rate: %s/Hour | %s/Day | %s/Week", formatValue(strHour), formatValue(strDay), formatValue(strWeek))
            DurabilityRateLabel.Text = string.format("Durability Rate: %s/Hour | %s/Day | %s/Week", formatValue(durHour), formatValue(durDay), formatValue(durWeek))
        end
        
        StatsCurrentLabel.Text = string.format("Stats: Fuerza: %s | Durabilidad: %s", formatValue(currentStrength), formatValue(currentDurability))
    end
end)
