    Default = false,
    Callback = function(v)
        if v then iniciarCalculadora(); Nova:Notify({ Title = "Calculadora", Text = "Muestreando...", Duration = 3 })
        else calcActivo = false; Nova:Notify({ Title = "Calculadora", Text = "Detenida", Duration = 3 }) end
    end,
})

