-- ============================================
-- CONFIGURACIÓN
-- ============================================
local LIB_URL = "https://raw.githubusercontent.com/TU-USUARIO/muscle-legends-lib/main/src/ML.lua"

-- ============================================
-- CARGA DE LA LIBRERÍA
-- ============================================
local success, MuscleLib = pcall(function()
    return loadstring(game:HttpGet(LIB_URL))()
end)

if not success or not MuscleLib then
    warn("[ML Script] No se pudo cargar la librería: " .. tostring(MuscleLib))
    return
end

-- ============================================
-- REFERENCIAS
-- ============================================
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer

-- ============================================
-- ESTADO DEL SCRIPT
-- ============================================
local State = {
    AutoStrength = false,
    AutoRebirth = false,
    AutoChests = false,
    AutoGifts = false,
    AntiAFK = true,
    SpeedFarm = false,
    CurrentGym = "Frost Gym (1 Rebirth)",
}

-- ============================================
-- UTILIDADES
-- ============================================
local function notify(title, text, dur)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = title,
            Text = text,
            Duration = dur or 3,
        })
    end)
end

local function getHumanoid()
    local char = LocalPlayer.Character
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function getHRP()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

-- ============================================
-- LÓGICA: AUTO STRENGTH (equipar pesas)
-- ============================================
local function equipWeightTool()
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not char or not backpack then return end

    local keywords = {"Weight", "Pushup", "Situp", "Dumbbell", "Barbell"}
    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") then
            for _, kw in ipairs(keywords) do
                if tool.Name:lower():find(kw:lower()) then
                    tool.Parent = char
                    return true
                end
            end
        end
    end
    return false
end

local function startAutoStrength()
    State.AutoStrength = true
    task.spawn(function()
        while State.AutoStrength do
            equipWeightTool()
            pcall(function()
                LocalPlayer.muscleEvent:FireServer("rep")
            end)
            task.wait(0.08)
        end
    end)
end

local function stopAutoStrength()
    State.AutoStrength = false
end

-- ============================================
-- LÓGICA: AUTO REBIRTH
-- ============================================
local function startAutoRebirth()
    State.AutoRebirth = true
    task.spawn(function()
        while State.AutoRebirth do
            pcall(function()
                ReplicatedStorage.rEvents.rebirthRemote:InvokeServer("rebirthRequest")
            end)
            task.wait(2)
        end
    end)
end

local function stopAutoRebirth()
    State.AutoRebirth = false
end

-- ============================================
-- LÓGICA: AUTO CLAIM CHESTS
-- ============================================
local ChestList = {
    "Magma Chest",
    "Mythical Chest",
    "Golden Chest",
    "Enchanted Chest",
    "Legends Chest",
}

local function startAutoChests()
    State.AutoChests = true
    task.spawn(function()
        while State.AutoChests do
            for _, chest in ipairs(ChestList) do
                if not State.AutoChests then break end
                pcall(function()
                    ReplicatedStorage.rEvents.checkChestRemote:InvokeServer(chest)
                end)
                task.wait(0.3)
            end
            task.wait(1)
        end
    end)
end

local function stopAutoChests()
    State.AutoChests = false
end

-- ============================================
-- LÓGICA: AUTO GIFTS (ProximityPrompts)
-- ============================================
local function startAutoGifts()
    State.AutoGifts = true
    task.spawn(function()
        while State.AutoGifts do
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("ProximityPrompt") and obj.Enabled then
                    local parentName = obj.Parent and obj.Parent.Name:lower() or ""
                    if parentName:find("gift") or parentName:find("present") then
                        pcall(function()
                            fireproximityprompt(obj)
                        end)
                        task.wait(0.2)
                    end
                end
            end
            task.wait(2)
        end
    end)
end

local function stopAutoGifts()
    State.AutoGifts = false
end

-- ============================================
-- LÓGICA: TELEPORT A GIMNASIO
-- ============================================
local Gyms = {
    ["Spawn / Playa"] = CFrame.new(-38, 7, 211),
    ["Frost Gym (1 Rebirth)"] = CFrame.new(-2623, 7, -409),
    ["Mythical Gym (5 Rebirths)"] = CFrame.new(2250, 7, 1073),
    ["Eternal Gym (15 Rebirths)"] = CFrame.new(-6758, 7, -1284),
    ["Legends Gym (30 Rebirths)"] = CFrame.new(4603, 987, -3897),
    ["Muscle King Gym"] = CFrame.new(-8625, 17, -5730),
}

local function teleportToGym(name)
    local cf = Gyms[name]
    local hrp = getHRP()
    if cf and hrp then
        hrp.CFrame = cf
        State.CurrentGym = name
        notify("Teleport", "→ " .. name)
    end
end

-- ============================================
-- LÓGICA: SPEED FARM (teleport + auto strength)
-- ============================================
local function startSpeedFarm()
    State.SpeedFarm = true
    task.spawn(function()
        while State.SpeedFarm do
            teleportToGym(State.CurrentGym)
            task.wait(0.3)
            equipWeightTool()
            task.wait(0.2)
        end
    end)
end

local function stopSpeedFarm()
    State.SpeedFarm = false
end

-- ============================================
-- UI ADICIONAL (se monta encima de la lib)
-- ============================================
local Window = MuscleLib:CreateWindow("Muscle Legends | Script Principal")

-- ---------- TAB 1: AUTO FARM ----------
local FarmTab = Window:CreateTab("⚡ Auto Farm")

FarmTab:CreateToggle("Auto Strength", false, function(v)
    if v then startAutoStrength() else stopAutoStrength() end
end)

FarmTab:CreateToggle("Auto Rebirth", false, function(v)
    if v then startAutoRebirth() else stopAutoRebirth() end
end)

FarmTab:CreateToggle("Auto Cofres", false, function(v)
    if v then startAutoChests() else stopAutoChests() end
end)

FarmTab:CreateToggle("Auto Regalos", false, function(v)
    if v then startAutoGifts() else stopAutoGifts() end
end)

FarmTab:CreateToggle("Anti-AFK", true, function(v)
    State.AntiAFK = v
end)

-- ---------- TAB 2: GIMNASIOS ----------
local GymTab = Window:CreateTab("🏋️ Gimnasios")

for gymName, _ in pairs(Gyms) do
    GymTab:CreateButton("TP: " .. gymName, function()
        teleportToGym(gymName)
    end)
end

GymTab:CreateButton("▶️ Iniciar Speed Farm (loop)", function()
    startSpeedFarm()
    notify("Speed Farm", "Activado en: " .. State.CurrentGym)
end)

GymTab:CreateButton("⏹️ Detener Speed Farm", function()
    stopSpeedFarm()
    notify("Speed Farm", "Detenido")
end)

-- ---------- TAB 3: JUGADOR ----------
local PlayerTab = Window:CreateTab("👤 Jugador")

PlayerTab:CreateButton("Velocidad 100", function()
    local hum = getHumanoid()
    if hum then hum.WalkSpeed = 100 end
end)

PlayerTab:CreateButton("Velocidad 50", function()
    local hum = getHumanoid()
    if hum then hum.WalkSpeed = 50 end
end)

PlayerTab:CreateButton("Velocidad Normal (16)", function()
    local hum = getHumanoid()
