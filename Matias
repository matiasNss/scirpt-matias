local antiAfkActivo = false
local antiAfkThread = nil

local function iniciarAntiAfk()
    if antiAfkActivo then return end
    antiAfkActivo = true
    antiAfkThread = task.spawn(function()
        while antiAfkActivo do
            task.wait(55)
            if not antiAfkActivo then break end
            pcall(function()
                if VirtualUser then
                    VirtualUser:CaptureController()
                    VirtualUser:ClickButton2(Vector2.new(0, 0))
                end
            end)
        end
    end)
end

local function detenerAntiAfk()
    antiAfkActivo = false
    if antiAfkThread then task.cancel(antiAfkThread); antiAfkThread = nil end
end

MiscTab:AddToggle({
    Name = "Anti-AFK Proactivo",
    Default = true,
    Callback = function(v)
        if v then iniciarAntiAfk(); Nova:Notify({ Title = "Anti-AFK", Text = "Activado", Duration = 3 })
        else detenerAntiAfk(); Nova:Notify({ Title = "Anti-AFK", Text = "Desactivado", Duration = 3 }) end
    end,
})

