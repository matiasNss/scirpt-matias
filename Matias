local function obtenerStats()
    local stats = LP:FindFirstChild("Stats") or LP:FindFirstChild("leaderstats")
    if not stats then return nil, nil end
    local str = stats:FindFirstChild("Strength") or stats:FindFirstChild("Strenght")
    local dur = stats:FindFirstChild("Durability")
    return str and str.Value or nil, dur and dur.Value or nil
end

local function formatear(n)
    if not n or n == 0 then return "0" end
    local abs = math.abs(n)
    if abs >= 1e9 then return string.format("%.2fB", n / 1e9) end
    if abs >= 1e6 then return string.format("%.2fM", n / 1e6) end
    if abs >= 1e3 then return string.format("%.2fK", n / 1e3) end
    return string.format("%.1f", n)
end

local function iniciarCalculadora()
    if calcActivo then return end
    calcActivo = true
    local s0, d0 = obtenerStats()
    ultimoStrength   = s0 or 0
    ultimoDurability = d0 or 0
    ultimoTiempo     = tick()
    muestrasStr, muestrasDur = {}, {}
    task.spawn(function()
        while calcActivo do
            task.wait(1)
            if not calcActivo then break end
            local s, d = obtenerStats()
            if s and d then
                local ahora = tick()
                local dt = ahora - ultimoTiempo
                if dt > 0 then
                    local ds, dd = s - ultimoStrength, d - ultimoDurability
                    ultimoStrength, ultimoDurability, ultimoTiempo = s, d, ahora
                    table.insert(muestrasStr, ds / dt)
                    table.insert(muestrasDur, dd / dt)
                    if #muestrasStr > MAX_MUESTRAS then table.remove(muestrasStr, 1) end
                    if #muestrasDur > MAX_MUESTRAS then table.remove(muestrasDur, 1) end
                    local sumS, sumD = 0, 0
                    for _, v in ipairs(muestrasStr) do sumS = sumS + v end
                    for _, v in ipairs(muestrasDur) do sumD = sumD + v end
                    tasaStrPorSeg = sumS / #muestrasStr
                    tasaDurPorSeg = sumD / #muestrasDur
                    if lblStrRate then
                        lblStrRate.Text = "Strength/seg: "    .. formatear(tasaStrPorSeg)
                        lblDurRate.Text = "Durability/seg: "  .. formatear(tasaDurPorSeg)
                        lblStrHour.Text = "Strength/hora: "   .. formatear(tasaStrPorSeg * 3600)
                        lblDurHour.Text = "Durability/hora: " .. formatear(tasaDurPorSeg * 3600)
                        lblStrDay.Text  = "Strength/día: "    .. formatear(tasaStrPorSeg * 86400)
                        lblDurDay.Text  = "Durability/día: "  .. formatear(tasaDurPorSeg * 86400)
                        lblStrWeek.Text = "Strength/semana: " .. formatear(tasaStrPorSeg * 604800)
                        lblDurWeek.Text = "Durability/semana: ".. formatear(tasaDurPorSeg * 604800)
                    end
                end
            end
        end
    end)
end

CalcTab:AddToggle({
