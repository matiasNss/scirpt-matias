local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/matiasNss/scirpt-matias/refs/heads/main/Matias", true))()

local Players = game:GetService("Players")
local VirtualUser = game:GetService("VirtualUser")
local LocalPlayer = Players.LocalPlayer

-- ==========================================
-- VARIABLES DE CONFIGURACIÓN
-- ==========================================
local Config = {
    FastRep = false,
    AutoRebirth = false,
    AntiAFK = false,
    SelectedTool = "Punch"
}

-- ==========================================
-- CREACIÓN DE LA INTERFAZ
-- ==========================================
local Window = Library:AddWindow("Muscle Legends - System", {
    main_color = Color3.fromRGB(0, 170, 255),
    min_size = Vector2.new(460, 400)
})

-- 1. PESTAÑA PRINCIPAL (FARMING)
local FarmTab = Window:AddTab("Farming")

FarmTab:AddLabel("--- Auto Ejercicio (Fast Rep) ---")

local ToolDropdown = FarmTab:AddDropdown("Herramienta", function(selected)
    Config.SelectedTool = selected
end)
ToolDropdown:Add("Punch")
ToolDropdown:Add("Weight")
ToolDropdown:Add("Pushups")
ToolDropdown:Add("Situps")

FarmTab:AddSwitch("Activar Fast Rep", function(state)
    Config.FastRep = state
end)

FarmTab:AddLabel("--- Rebirth Automático ---")

FarmTab:AddSwitch("Auto Rebirth", function(state)
    Config.AutoRebirth = state
end)


-- 2. PESTAÑA DE CALCULADORA Y ESTADÍSTICAS
local StatsTab = Window:AddTab("Stats & Calc")

StatsTab:AddLabel("--- Tus Estadísticas Actuales ---")

local StrengthLabel = StatsTab:AddLabel("Fuerza: Cargando...")
local DurabilityLabel = StatsTab:AddLabel("Durabilidad: Cargando...")
local AgilityLabel = StatsTab:AddLabel("Agilidad: Cargando...")
local RebirthsLabel = StatsTab:AddLabel("Rebirths: Cargando...")

StatsTab:AddLabel("--- Calculadora de Ganancias ---")
local GainPerRepBox = StatsTab:AddTextBox("Fuerza/Durabilidad por repetición (ej: 50)", function(text) end)
local RepsPerMinBox = StatsTab:AddTextBox("Repeticiones estimadas por minuto (ej: 120)", function(text) end)

local CalcHourLabel = StatsTab:AddLabel("Por Hora: 0")
local CalcDayLabel = StatsTab:AddLabel("Por Día: 0")
local CalcWeekLabel = StatsTab:AddLabel("Por Semana: 0")

StatsTab:AddButton("Calcular Ganancias (Fuerza/Durabilidad)", function()
    local gain = tonumber(GainPerRepBox.Text)
    local repsMin = tonumber(RepsPerMinBox.Text)
    
    if gain and repsMin then
        local perMinute = gain * repsMin
        local perHour = perMinute * 60
        local perDay = perHour * 24
        local perWeek = perDay * 7
        
        CalcHourLabel.Text = string.format("Por Hora: %s", tostring(perHour))
        CalcDayLabel.Text = string.format("Por Día: %s", tostring(perDay))
        CalcWeekLabel.Text = string.format("Por Semana: %s", tostring(perWeek))
    else
        CalcHourLabel.Text = "Por Hora: Introduce números válidos"
        CalcDayLabel.Text = "Por Día: -"
        CalcWeekLabel.Text = "Por Semana: -"
    end
end)


-- 3. PESTAÑA DE AJUSTES & AFK
local SettingsTab = Window:AddTab("Ajustes")

SettingsTab:AddLabel("--- Protección ---")

SettingsTab:AddSwitch("Anti AFK (Desconexión)", function(state)
    Config.AntiAFK = state
end)

SettingsTab:AddButton("Cerrar Script / UI", function()
    Library:Unload()
end)


-- ==========================================
-- LÓGICA / LOOPS DEL SCRIPT
-- ==========================================

-- Loop Fast Rep
task.spawn(function()
    while task.wait() do
        if Config.FastRep and LocalPlayer.Character then
            local tool = LocalPlayer.Backpack:FindFirstChild(Config.SelectedTool) or LocalPlayer.Character:FindFirstChild(Config.SelectedTool)
            if tool then
                if tool.Parent == LocalPlayer.Backpack then
                    LocalPlayer.Character.Humanoid:EquipTool(tool)
                end
                tool:Activate()
            end
        end
    end
end)

-- Loop Auto Rebirth
task.spawn(function()
    while task.wait(0.5) do
        if Config.AutoRebirth then
            local rebirthEvent = game:GetService("ReplicatedStorage"):FindFirstChild("rEvents") 
                and game:GetService("ReplicatedStorage").rEvents:FindFirstChild("rebirthRemote")
            
            if rebirthEvent then
                rebirthEvent:InvokeServer("rebirthRequest")
            end
        end
    end
end)

-- Anti AFK
LocalPlayer.Idled:Connect(function()
    if Config.AntiAFK then
        VirtualUser:CaptureController()
        VirtualUser:ClickButton2(Vector2.new(0, 0))
    end
end)

-- Actualización en tiempo real de Estadísticas
task.spawn(function()
    while task.wait(1) do
        if LocalPlayer:FindFirstChild("leaderstats") then
            local leaderstats = LocalPlayer.leaderstats
            
            if leaderstats:FindFirstChild("Strength") then
                StrengthLabel.Text = "Fuerza: " .. tostring(leaderstats.Strength.Value)
            end
            if leaderstats:FindFirstChild("Rebirths") then
                RebirthsLabel.Text = "Rebirths: " .. tostring(leaderstats.Rebirths.Value)
            end
        end
        
        if LocalPlayer:FindFirstChild("Agility") then
            AgilityLabel.Text = "Agilidad: " .. tostring(LocalPlayer.Agility.Value)
        end
        if LocalPlayer:FindFirstChild("Durability") then
            DurabilityLabel.Text = "Durabilidad: " .. tostring(LocalPlayer.Durability.Value)
        end
    end
end)
