        hum.UseJumpPower = true
        hum.JumpPower = 50
    end
end)

PlayerTab:CreateButton("Reclamar Todos los Cofres", function()
    for _, chest in ipairs(ChestList) do
        pcall(function()
            ReplicatedStorage.rEvents.checkChestRemote:InvokeServer(chest)
        end)
        task.wait(0.3)
    end
    notify("Cofres", "Reclamados ✔")
end)

-- ---------- TAB 4: UTILIDADES ----------
local UtilTab = Window:CreateTab("🛠️ Util")

UtilTab:CreateButton("🌐 Mostrar posición (print)", function()
    local hrp = getHRP()
    if hrp then
        print("[ML] Posición actual:", hrp.Position)
        print("[ML] CFrame:", tostring(hrp.CFrame))
    end
end)

UtilTab:CreateButton("📋 Copiar lista de cofres", function()
    print("[ML] Cofres disponibles:", table.concat(ChestList, ", "))
    notify("Util", "Lista impresa en consola (F9)")
end)

UtilTab:CreateButton("🔄 Recargar script", function()
    -- útil si la librería cambió y quieres reiniciar
    if game.CoreGui:FindFirstChild("MuscleLegendsLib") then
        game.CoreGui.MuscleLegendsLib:Destroy()
    end
    notify("Script", "Recarga manual (vuelve a ejecutar)")
end)

-- ============================================
-- ANTI-AFK integrado en el script (independiente)
-- ============================================
LocalPlayer.Idled:Connect(function()
    if State.AntiAFK then
        local VU = game:GetService("VirtualUser")
        VU:CaptureController()
        VU:ClickButton2(Vector2.new())
    end
end)

-- ============================================
